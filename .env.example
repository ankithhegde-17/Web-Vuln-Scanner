# Copy this file to .env and fill in a real key to enable LLM triage (Phase 3).
# .env is gitignored and must NEVER be committed. These are placeholders only.

# For the default provider (Claude). Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed if you run triage with --llm-provider openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
